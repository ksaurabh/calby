# Google OAuth credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3005/auth/google/callback

# Session secret (generate a random string for production)
SESSION_SECRET=your-session-secret-change-in-production

# Client URL (Vite dev server)
CLIENT_URL=http://localhost:5178

# Server port
PORT=3005

# Frontend API URL (used by Vite - must be prefixed with VITE_)
# Leave blank in production so the frontend uses same-origin relative URLs.
VITE_API_URL=http://localhost:3005

# Where Google returns after the Calendar consent screen. Must be registered as
# an Authorized redirect URI on the same OAuth client. Defaults to
# <CLIENT_URL>/api/calendar/callback, which is right in production; set it
# explicitly in local dev because the API is on a different port to the frontend.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3005/api/calendar/callback

# Anthropic API key — used by the scheduling agent, the commitment-type
# classifier, the calendar assistant and the per-event reports.
#
# This is the server-wide fallback. An admin of an organization can instead
# supply a key on the Organizations page, which then covers everyone with an
# email address on that org's domain. Org keys are verified with Anthropic
# before being stored, and are encrypted at rest using ANTHROPIC_KEY_SECRET (or
# SESSION_SECRET when that is unset).
#
# With no key at all, guidance falls back to simple text parsing and commitment
# classification to keyword matching; the assistant and reports are unavailable.
ANTHROPIC_API_KEY=

# Optional: a dedicated secret for encrypting stored API keys. Defaults to
# SESSION_SECRET. Changing whichever is in use makes stored org keys
# undecryptable — they are then treated as unset and must be re-entered.
ANTHROPIC_KEY_SECRET=
